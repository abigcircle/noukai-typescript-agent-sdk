# Local env for @noukai/agent integration tests.
#
#   cp .env.example .env   # then fill in a real nk_* key
#   pnpm test:integration
#
# Loaded by tests/agent-loop.integration.test.ts via `dotenv`. NOT read by the
# package at runtime — only by the integration test. NEVER commit .env (gitignored).

# Deployment target for the relay's @noukai/sdk client.
#   "dev" -> http://localhost:8080/api/v1 ; unset/"production" -> https://api.noukai.dev/api/v1
NOUKAI_ENV=dev

# Real nk_* API key for the integration test account (the relay injects it upstream).
NOUKAI_INTEGRATION_KEY=nk_replace_me

# "org/project" pair holding the fixture flow.
NOUKAI_INTEGRATION_PROJECT=abc/tests-integration

# Slug of the kind=chat agent flow (accepts messages[], get_weather tool enabled).
# Shared with the base @noukai/sdk integration suite.
NOUKAI_INTEGRATION_AGENT_SLUG=agent-tools
